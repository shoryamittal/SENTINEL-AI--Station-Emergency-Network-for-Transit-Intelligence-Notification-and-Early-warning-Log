def init_system():
    """Initialize all system components"""
    global monitor_components
    try:
        monitor_components = {
            "analyzer": CrowdDensityAnalyzer(model_name="yolov8n.pt", confidence_threshold=0.5),
            "mapper": OccupancyMapper(grid_size=(4, 6), zone_area_m2=10.0),
            "predictor": DensityPredictor(history_length=60, prediction_horizon=5.0),
            "classifier": SituationClassifier(green_threshold=4.0, yellow_threshold=5.0, red_threshold=6.0),
            "executor": ActionExecutor(station_name="Central Station")
        }
        return True
    except Exception as e:
        print(f"Init error: {e}")
        return False

@app.route('/')
def index():
    return HTML_TEMPLATE

@app.route('/process_frame', methods=['POST'])
def process_frame():
    global monitor_components, current_info
    try:
        if monitor_components is None:
            if not init_system():
                return jsonify({"success": False, "error": "System initialization failed"}), 500
        
        data = request.json
        image_data = data['image']
        
        # Decode base64 image
        img_str = image_data.split(',')[1]
        img_bytes = base64.b64decode(img_str)
        nparr = np.frombuffer(img_bytes, np.uint8)
        img = cv2.imdecode(nparr, cv2.IMREAD_COLOR)
        
        if img is None:
            return jsonify({"success": False, "error": "Invalid image"}), 400
        
        # Process the frame
        detections = monitor_components["analyzer"].detect_people(img)
        grid = monitor_components["mapper"].create_grid(img.shape)
        grid = monitor_components["mapper"].map_detections_to_grid(grid, detections)
        density_grid, stats = monitor_components["mapper"].calculate_density(grid)
        
        monitor_components["predictor"].update_history(stats)
        prediction = monitor_components["predictor"].predict_future_density(time_minutes=5.0)
        state, confidence = monitor_components["classifier"].classify(stats["max_density"], "stable", prediction)
        
        actions = monitor_components["classifier"].get_recommended_actions(state)
        monitor_components["executor"].execute_actions(actions, state, max_density=stats["max_density"], people_count=stats["total_people"])
        
        current_info = {
            "state": state,
            "confidence": confidence,
            "peopleCount": stats["total_people"],
            "maxDensity": stats["max_density"]
        }
        
        return jsonify({
            "success": True,
            "state": state,
            "confidence": confidence,
            "peopleCount": stats["total_people"],
            "maxDensity": stats["max_density"]
        })
        
    except Exception as e:
        print(f"Processing error: {e}")
        return jsonify({"success": False, "error": str(e)}), 500

@app.route('/status')
def get_status():
    global current_info
    return jsonify({
        "success": True,
        "info": current_info
    })

import os

if __name__ == '__main__':
    init_system()
    port = int(os.environ.get("PORT", 5000))
    print("=" * 80)
    print(" SENTINEL AI - Phone Camera Ready!")
    print("=" * 80)
    print(f" Access this URL on your phone to use your phone's camera!")
    print(f" Local: http://localhost:{port}")
    print(" Network: http://[your-local-ip]:{port} (find your local IP address)".format(port=port))
    print("=" * 80)
    app.run(host='0.0.0.0', port=port, debug=False, threaded=True)
