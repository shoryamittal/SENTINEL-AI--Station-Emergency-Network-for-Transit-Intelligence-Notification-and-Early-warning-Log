        let video = null;
        let canvas = null;
        let ctx = null;
        let stream = null;
        let animationId = null;
        
        let lastUpdate = null;
        
        // Initialize components on page load
        window.onload = function() {
            video = document.getElementById('phoneCamera');
            canvas = document.getElementById('canvas');
            ctx = canvas.getContext('2d');
        }
        
        async function startSystem() {
            try {
                stream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        facingMode: 'environment',
                        width: { ideal: 1280 },
                        height: { ideal: 720 }
                    },
                    audio: false
                });
                video.srcObject = stream;
                
                // Start processing loop
                startProcessing();
                
                document.getElementById('startBtn').style.display = 'none';
                document.getElementById('stopBtn').style.display = 'inline-block';
            } catch (err) {
                console.error('Error accessing camera:', err);
                alert('Could not access camera. Please allow camera access.');
            }
        }
        
        function stopSystem() {
            if (stream) {
                stream.getTracks().forEach(track => track.stop());
            }
            if (animationId) cancelAnimationFrame(animationId);
            document.getElementById('startBtn').style.display = 'inline-block';
            document.getElementById('stopBtn').style.display = 'none';
        }
        
        async function startProcessing() {
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
            
            // Convert canvas to base64 image
            const imageData = canvas.toDataURL('image/jpeg', 0.6);
            
            try {
                const response = await fetch('/process_frame', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        image: imageData
                    })
                });
                const results = await response.json();
                
                if (results.success) {
                    updateUI(results);
                }
            } catch (e) {
                console.error('Error processing frame:', e);
            }
            
            animationId = requestAnimationFrame(startProcessing);
        }
        
        function updateUI(results) {
            const state = results.state;
            const stateIndicator = document.getElementById('statusIndicator');
            stateIndicator.className = 'status-indicator ' + state.toLowerCase();
            document.getElementById('stateText').textContent = state;
            document.getElementById('confidenceText').textContent = `Confidence: ${(results.confidence * 100).toFixed(1)}%`;
            document.getElementById('peopleCount').textContent = results.peopleCount;
            document.getElementById('maxDensity').textContent = results.maxDensity.toFixed(2);
        }
    </script>
</body>
