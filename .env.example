# Suraksha Kavach AI - Environment Variables
# Copy this file to .env and fill in your values

# Fast2SMS API Key (for real SMS alerts, India only)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Station Configuration
STATION_NAME=Central Station

# Camera Configuration
CAMERA_SOURCE=0
TARGET_FPS=30

# YOLO Configuration
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5

# Density Thresholds
GREEN_THRESHOLD=4.0
YELLOW_THRESHOLD=5.0
RED_THRESHOLD=6.0

# ------------------------------------------------------------------
# Round 2 continuity plane (deploy.py) -- all optional, all have defaults
# ------------------------------------------------------------------

# SentinelRuntime occupancy grid size
GRID_ROWS=4
GRID_COLS=6

# Path to the durable incident journal (auto-created)
SENTINEL_DB_PATH=data/sentinel.db

# How often the background connectivity check runs
CONNECTIVITY_CHECK_INTERVAL_S=5.0

# MockSyncAdapter fault-injection mode for demos/tests:
# NORMAL | SLOW | TIMEOUT | OFFLINE | DUPLICATE_ACCEPTED
SYNC_ADAPTER_MODE=NORMAL

# Set to 1 to also attempt a best-effort Fast2SMS notification alongside
# the (always-on) local dashboard alert. A Fast2SMS failure never blocks
# or delays the local alert either way.
ENABLE_FAST2SMS=0
