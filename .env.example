# SENTINEL AI - Round 2 Environment Variables
# Copy this file to .env and adjust local deployment settings as needed.

# Optional best-effort Fast2SMS notifier. It never blocks local alerts.
FAST2SMS_API_KEY=your_fast2sms_api_key_here
ENABLE_FAST2SMS=0

STATION_NAME=Central Station

# Camera index or local video file path.
CAMERA_SOURCE=0

# Local Safety Plane model and 4x6 occupancy grid settings.
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
GRID_ROWS=4
GRID_COLS=6

# Durable local SQLite incident journal (created automatically).
SENTINEL_DB_PATH=data/sentinel.db

# Background connectivity probe interval.
CONNECTIVITY_CHECK_INTERVAL_S=5.0

# DEVELOPMENT / DEMO fault-injection only: NORMAL | SLOW | TIMEOUT | OFFLINE |
# DUPLICATE_ACCEPTED. MockSyncAdapter is not a production cloud backend.
SYNC_ADAPTER_MODE=NORMAL
