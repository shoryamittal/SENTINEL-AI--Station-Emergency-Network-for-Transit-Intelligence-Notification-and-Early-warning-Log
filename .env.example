# SENTINEL AI - Round 2 Environment Variables
# Copy this file to .env and adjust local deployment settings as needed.

# Optional best-effort Fast2SMS notifier. It never blocks local alerts.
FAST2SMS_API_KEY=your_fast2sms_api_key_here
ENABLE_FAST2SMS=0

STATION_NAME=Central Station

# Camera index or local video file path.
CAMERA_SOURCE=0

# Local Safety Plane model and 4x6 occupancy grid settings.
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
GRID_ROWS=4
GRID_COLS=6

# Durable local SQLite incident journal (created automatically).
SENTINEL_DB_PATH=data/sentinel.db

# Background connectivity probe interval.
CONNECTIVITY_CHECK_INTERVAL_S=5.0

# Keep dashboard/status/CCTV data local by default. Use 0.0.0.0 only for a
# controlled LAN demonstration.
SENTINEL_BIND_HOST=127.0.0.1

# Demo connectivity override is disabled by default; physical WAN loss is the
# preferred continuity proof.
ENABLE_DEBUG_CONNECTIVITY=0

# Sync defaults to the local deterministic mock. MockSyncAdapter is not a
# production cloud backend. DEVELOPMENT / DEMO fault injection only:
# NORMAL | SLOW | TIMEOUT | OFFLINE | DUPLICATE_ACCEPTED.
SYNC_ADAPTER_TYPE=MOCK
SYNC_ADAPTER_MODE=NORMAL

# Used only when SYNC_ADAPTER_TYPE=HTTP. This is the localhost qualification/
# reference backend for proving protocol idempotency, not production cloud.
SYNC_ENDPOINT_URL=http://127.0.0.1:5051/api/events
SYNC_HTTP_TIMEOUT_S=2.0

# HTTP qualification sync only. This is a protocol-test credential, not a
# production identity system. Leave blank unless the server requires a token.
SYNC_BEARER_TOKEN=

# Qualification server only. Optional localhost demo token, not production
# authentication, authorization, TLS, or secret management.
QUALIFICATION_API_TOKEN=
